{
  "name": "cardigan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @cardigan/web build",
    "test": "vitest run",
    "lint": "biome check .",
    "check:deps": "depcruise packages/*/src apps/*/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "dependency-cruiser": "18.7.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
